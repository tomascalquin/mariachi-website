PORT=3000
NODE_ENV=production

# --- Base de datos Turso ---
# Obtén estos valores en: app.turso.tech → tu base de datos → "Connect"
# Para desarrollo local, usa: TURSO_DATABASE_URL=file:./db/mariachi.db  (sin TOKEN)
TURSO_DATABASE_URL=libsql://TU-DATABASE.turso.io
TURSO_AUTH_TOKEN=tu_token_aqui

# --- Cloudinary (galería de fotos) ---
# Obtén estos valores en: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- JWT (sesión del panel admin) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_generado

# --- CORS (en producción, pon la URL real de tu sitio en Vercel) ---
# Ejemplo: SITE_URL=https://mariachilunadorada.vercel.app
SITE_URL=
